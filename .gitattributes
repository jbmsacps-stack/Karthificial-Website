# Normalize text files
* text=auto

# Web/source files use LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.java text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows scripts use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf