run = "bash start.sh"

[nix]
channel = "stable-24_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server/backend && chmod +x mvnw && ./mvnw spring-boot:run"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd server/backend && java -jar target/backend-0.0.1-SNAPSHOT.jar"]
build = ["bash", "-c", "cp -r client deploy-folder/ && cd server/backend && chmod +x mvnw && ./mvnw package -DskipTests -q"]
